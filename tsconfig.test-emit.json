{
  "extends": "./tsconfig.scripts.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": ".",
    "outDir": "build-ts"
  },
  "include": [
    "test/**/*.ts",
    "test/**/*.mts",
    "scripts/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build-ts",
    "release",
    "release-core",
    ".local-data",
    "test/fixtures"
  ]
}
