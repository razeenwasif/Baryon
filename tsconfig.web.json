{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true
  },
  "include": [
    "web/src/**/*.ts",
    "web/src/**/*.tsx",
    "web/src/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "web/dist"
  ]
}
