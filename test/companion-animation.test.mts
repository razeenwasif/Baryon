import test from 'node:test';import assert from 'node:assert/strict';import {CompanionAnimation,type CompanionTickOptions} from '../src/companion-animation.js';
const advance=(a: CompanionAnimation,n: number,options: CompanionTickOptions={})=>{for(let t=0;t<n-.00001;t+=.05)a.tick(.05,options);};
test('Spotify starts headphones, pauses for interaction, resumes, and ends on playback stop',()=>{const a=new CompanionAnimation(()=>0);a.tick(.05,{music:true});assert.equal(a.kind,'headphones');advance(a,1,{music:true});assert(a.sample().frame>0);a.tick(.05,{music:true,allowed:false});assert.equal(a.kind,null);a.tick(.05,{music:true});assert.equal(a.kind,'headphones');a.tick(.05,{music:false});assert.equal(a.kind,null);});
test('hair and halo alternate with natural idle gaps',()=>{const a=new CompanionAnimation(()=>0);advance(a,56);assert.equal(a.kind,'hair');advance(a,4);assert.equal(a.kind,null);advance(a,56);assert.equal(a.kind,'halo');advance(a,5);assert.equal(a.kind,null);assert.equal(a.nextGesture,'hair');});
test('gestures wait for sitting or walking instead of overlapping',()=>{const a=new CompanionAnimation(()=>0);a.gestureIn=.01;advance(a,10,{available:false});assert.equal(a.kind,null);assert.equal(a.gestureIn,.01);a.tick(.05);assert.equal(a.kind,'hair');});
test('sleep follows inactivity with Fairy and explicit interaction wakes her',()=>{const a=new CompanionAnimation(()=>0);a.inactivity=599.95;a.tick(.1);assert.equal(a.kind,'sleep');advance(a,10);assert([5,6,7].includes(a.sample().frame));a.interact();assert.equal(a.kind,null);assert.equal(a.inactivity,0);a.tick(.05);assert.equal(a.kind,null);});
test('nap enters, holds, wakes and returns to default idle',()=>{const a=new CompanionAnimation(()=>0);a.play('sleep',true);advance(a,2);assert(a.sample().frame>0&&a.sample().frame<5);advance(a,8);assert([5,6,7].includes(a.sample().frame));advance(a,44);assert.equal(a.sample().phase,'stretch');assert(a.sample().frame>=4);advance(a,4);assert.equal(a.kind,null);});
test('leg swing completes a bounded seated rest',()=>{const a=new CompanionAnimation(()=>0);a.legsIn=0;a.tick(.05);assert.equal(a.kind,'legs');advance(a,3);assert(a.sample().frame>=0&&a.sample().frame<8);advance(a,28);assert.equal(a.kind,null);assert(a.legsIn>350);});
test('missing assets freeze the pose timeline until ready',()=>{const a=new CompanionAnimation(()=>0);a.play('halo',true);advance(a,20,{ready:false});assert.equal(a.time,0);assert.equal(a.kind,'halo');advance(a,5);assert.equal(a.kind,null);});
test('manual previews work with automatic animations off but not with reduced motion or blocked activity',()=>{const a=new CompanionAnimation(()=>0);a.play('hair',true);a.tick(.1,{enabled:false});assert.equal(a.kind,'hair');a.tick(.1,{reduced:true});assert.equal(a.kind,null);advance(a,700,{enabled:false});assert.equal(a.kind,null);a.play('legs',true);a.tick(.1,{allowed:false});assert.equal(a.kind,null);});
test('Stop snoozes music animation; large timing jumps never fast-forward frames',()=>{const a=new CompanionAnimation(()=>0);a.play('headphones');a.stop(30);advance(a,29,{music:true});assert.equal(a.kind,null);advance(a,2,{music:true});assert.equal(a.kind,'headphones');a.play('hair',true);a.tick(500);assert.equal(a.time,.1);});
test('manual headphones preview ends without requiring Spotify or altering playback',()=>{const a=new CompanionAnimation(()=>0);a.play('headphones',true);advance(a,4);assert.equal(a.kind,'headphones');advance(a,5);assert.equal(a.kind,null);assert.equal(a.play('unknown' as any),false);});

test('star catching runs its eight poses once and returns to idle',()=>{const a=new CompanionAnimation(()=>0);a.starsIn=0;a.tick(.05);assert.equal(a.kind,'stars');for(const [time,frame] of [[0,0],[.8,1],[1.5,2],[2.5,3],[3.5,4],[4.5,5],[5.5,6],[6.5,7]]){a.time=time;assert.equal(a.sample().frame,frame);}advance(a,.6);assert.equal(a.kind,null);assert(a.starsIn>149);});
test('star preview obeys interruption and reduced motion and never overlaps walking',()=>{const a=new CompanionAnimation(()=>0);a.starsIn=0;a.tick(.1,{available:false});assert.equal(a.kind,null);a.play('stars',true);a.tick(.1,{reduced:true});assert.equal(a.kind,null);a.play('stars',true);a.tick(.1,{allowed:false});assert.equal(a.kind,null);});
test('hover and other animations do not erase the nap interaction clock',()=>{const a=new CompanionAnimation(()=>0);advance(a,590,{allowed:false,napAllowed:true});assert.equal(a.kind,null);a.play('stars');advance(a,7.1);assert(a.inactivity>597);advance(a,3.1,{allowed:false,napAllowed:true});assert.equal(a.kind,'sleep');advance(a,1,{allowed:false,napAllowed:true});assert.equal(a.kind,'sleep');});
test('old reply/hover may allow nap but active work, music and motion preference do not',()=>{for(const options of [{allowed:false,napAllowed:false},{music:true},{reduced:true},{enabled:false},{available:false}]){const a=new CompanionAnimation(()=>0);a.inactivity=610;a.tick(.1,options);assert.notEqual(a.kind,'sleep');}});
test('a cancelled or completed nap waits another ten minutes, gestures preserve inactivity',()=>{const a=new CompanionAnimation(()=>0);a.inactivity=600;a.tick(.1);assert.equal(a.kind,'sleep');a.tick(.1,{allowed:false});assert.equal(a.kind,null);a.tick(.1);assert.equal(a.kind,null);assert(a.nextNap>=1200);const age=a.inactivity;a.stop();assert.equal(a.inactivity,age);a.play('sleep',true);advance(a,58);assert.equal(a.kind,null);assert(a.nextNap>a.inactivity+590);});
test('direct interactions postpone naps while unrelated activity cannot reset them',()=>{const a=new CompanionAnimation(()=>0);a.inactivity=599;a.interact();advance(a,5,{allowed:false});assert(a.inactivity>=4.9&&a.inactivity<5.1);a.tick(.1);assert.notEqual(a.kind,'sleep');});

test('nap selects yawn, sleep and waking stretch in order and pauses for sheet readiness',()=>{const a=new CompanionAnimation(()=>0);a.play('sleep',true);assert.equal(a.sample().sheet,'yawn');advance(a,3.3);assert.equal(a.sample().sheet,'sleep');const before=a.time;advance(a,4,{ready:false});assert.equal(a.time,before);advance(a,50);assert.equal(a.sample().sheet,'yawn');assert.equal(a.sample().phase,'stretch');advance(a,4);assert.equal(a.kind,null);});
test('yawn preview is bounded and direct interaction cancels nap without a delayed stretch',()=>{const a=new CompanionAnimation(()=>0);a.play('yawn',true);advance(a,7.3);assert.equal(a.kind,null);a.play('sleep',true);advance(a,10);a.interact();assert.equal(a.kind,null);assert.equal(a.sample().sheet,null);advance(a,4);assert.equal(a.kind,null);});
